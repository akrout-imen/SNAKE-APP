# =============================================================================
# Copier ce fichier en "secrets.toml" (meme dossier) et remplir les valeurs.
# secrets.toml est ignore par git : ne jamais le versionner.
# =============================================================================

# -----------------------------------------------------------------------------
# CONFIGURATION EMAIL (SMTP gratuit) - optionnelle
# Sans cette section, l'app fonctionne mais n'envoie pas de notifications.
#
# --- Mise en place avec Gmail ---
# 1. Compte Google > Securite > activer la "validation en deux etapes".
# 2. Compte Google > Securite > "Mots de passe des applications" >
#    en creer un. Google donne 16 caracteres.
# 3. Copier ces 16 caracteres dans "password" ci-dessous.
# 4. Mettre votre adresse Gmail dans "sender".
#
# Sur Streamlit Community Cloud : coller ce contenu dans
#   Manage app > Settings > Secrets.
# -----------------------------------------------------------------------------
[email]
smtp_host   = "smtp.gmail.com"
smtp_port   = 587
sender      = "votre.adresse@gmail.com"
password    = "xxxx xxxx xxxx xxxx"
sender_name = "SNAKE - Reservation Lab"

# Optionnel : lien inclus dans les emails (URL publique de l'app).
app_url     = ""

# -----------------------------------------------------------------------------
# MOT DE PASSE ADMIN INITIAL
# Enregistre (hache) en base au premier lancement uniquement.
# -----------------------------------------------------------------------------
[admin]
password    = "changez-moi"
